datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPERADMIN
  ADMIN
  CUSTOMER
}

enum SeatStatus {
  AVAILABLE
  LOCKED
  SOLD
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
  EXPIRED
}

enum TicketStatus {
  ACTIVE
  CHECKED_IN
  CANCELLED
}

enum EventStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum RefundStatus {
  REQUESTED
  APPROVED
  REJECTED
}

enum PaymentMethod {
  MANUAL_TRANSFER
  DOKU_VA
  DOKU_QRIS
  DOKU_EWALLET
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  password      String
  fullName      String    @map("full_name")
  phoneNumber   String?   @map("phone_number")
  avatarUrl     String?   @map("avatar_url")
  phoneVerified Boolean   @default(false) @map("phone_verified")
  otpCodeHash   String?   @map("otp_code_hash")
  otpExpiresAt  DateTime? @map("otp_expires_at")
  role          Role      @default(CUSTOMER)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  createdEvents  Event[]    @relation("EventCreator")
  orders         Order[]    @relation("CustomerOrders")
  scannedTickets Ticket[]   @relation("AdminScannedTickets")
  auditLogs      AuditLog[]
  notifications  Notification[]
  sentChats      ChatMessage[]  @relation("ChatSender")
  receivedChats  ChatMessage[]  @relation("ChatReceiver")

  @@map("users")
}

model Event {
  id          String      @id @default(uuid())
  title       String
  description String      @db.Text
  venueName   String      @map("venue_name")
  eventDate   DateTime    @map("event_date")
  bannerUrl   String?     @map("banner_url")
  status      EventStatus @default(DRAFT)
  salesClosed Boolean     @default(false) @map("sales_closed")
  isSeated    Boolean     @default(true) @map("is_seated")
  createdById String      @map("created_by_id")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  createdBy        User             @relation("EventCreator", fields: [createdById], references: [id], onDelete: Restrict)
  ticketCategories TicketCategory[]
  artists          EventArtist[]

  @@map("events")
}

model Artist {
  id        String   @id @default(uuid())
  name      String
  bio       String?  @db.Text
  photoUrl  String?  @map("photo_url")
  createdAt DateTime @default(now()) @map("created_at")

  events EventArtist[]

  @@map("artists")
}

model EventArtist {
  eventId     String  @map("event_id")
  artistId    String  @map("artist_id")
  isHeadliner Boolean @default(false) @map("is_headliner")

  event  Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@id([eventId, artistId])
  @@map("event_artists")
}

model TicketCategory {
  id             String    @id @default(uuid())
  eventId        String    @map("event_id")
  name           String
  price          Decimal   @db.Decimal(12, 2)
  totalSeats     Int       @map("total_seats")
  salesStartDate     DateTime? @map("sales_start_date")
  salesEndDate       DateTime? @map("sales_end_date")
  earlyBirdPrice     Decimal?  @db.Decimal(12, 2) @map("early_bird_price")
  earlyBirdStartDate DateTime? @map("early_bird_start_date")
  earlyBirdEndDate   DateTime? @map("early_bird_end_date")
  createdAt          DateTime  @default(now()) @map("created_at")

  event   Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  seats   Seat[]
  tickets Ticket[]

  @@map("ticket_categories")
}

model Seat {
  id             String     @id @default(uuid())
  categoryId     String     @map("category_id")
  seatNumber     String     @map("seat_number")
  status         SeatStatus @default(AVAILABLE)
  lockedUntil    DateTime?  @map("locked_until")
  lockedByUserId String?    @map("locked_by_user_id")

  category TicketCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  ticket   Ticket?

  @@unique([categoryId, seatNumber])
  @@map("seats")
}

model Order {
  id              String        @id @default(uuid())
  orderNumber     String        @unique @map("order_number")
  customerId      String        @map("customer_id")
  totalAmount     Decimal       @map("total_amount") @db.Decimal(12, 2)
  status          OrderStatus   @default(PENDING)
  paymentProof    String?       @map("payment_proof")
  paymentMethod   PaymentMethod @default(MANUAL_TRANSFER) @map("payment_method")
  dokuReferenceId String?       @unique @map("doku_reference_id")
  paymentChannel  String?       @map("payment_channel")
  expiresAt       DateTime      @map("expires_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  customer User     @relation("CustomerOrders", fields: [customerId], references: [id], onDelete: Restrict)
  tickets  Ticket[]
  refund   Refund?

  @@map("orders")
}

model Ticket {
  id               String       @id @default(uuid())
  orderId          String       @map("order_id")
  categoryId       String       @map("category_id")
  seatId           String?      @unique @map("seat_id")
  ticketCode       String       @unique @map("ticket_code")
  status           TicketStatus @default(ACTIVE)
  checkedInAt      DateTime?    @map("checked_in_at")
  checkedInByAdmin String?      @map("checked_in_by_admin")
  createdAt        DateTime     @default(now()) @map("created_at")

  order           Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  category        TicketCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  seat            Seat?          @relation(fields: [seatId], references: [id], onDelete: Restrict)
  adminWhoScanned User?          @relation("AdminScannedTickets", fields: [checkedInByAdmin], references: [id])

  @@map("tickets")
}

model Refund {
  id          String       @id @default(uuid())
  orderId     String       @unique @map("order_id")
  reason      String       @db.Text
  status      RefundStatus @default(REQUESTED)
  processedBy String?      @map("processed_by")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("refunds")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  action    String
  entityId  String?  @map("entity_id")
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("audit_logs")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  title     String
  message   String   @db.Text
  type      String   // "SYSTEM", "ORDER", "CHAT", "REFUND"
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model ChatMessage {
  id         String   @id @default(uuid())
  senderId   String   @map("sender_id")
  receiverId String?  @map("receiver_id")
  message    String   @db.Text
  isRead     Boolean  @default(false) @map("is_read")
  createdAt  DateTime @default(now()) @map("created_at")

  sender   User  @relation("ChatSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User? @relation("ChatReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@map("chat_messages")
}
